<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardCornerRadius="24dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FFFEFA">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <FrameLayout android:layout_width="match_parent" android:layout_height="178dp">
   <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
   <TextView android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:background="@drawable/bg_message_input" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/forest" />
   <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/bookmark" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_message_input" android:src="@drawable/ic_bookmark" android:padding="14dp" android:contentDescription="@string/save" app:tint="@color/forest" />
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
   <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" />
   <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>